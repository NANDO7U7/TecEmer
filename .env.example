# ============================================
# EcoScan AI UGB — Variables de Entorno
# ============================================
# 📋 Instrucciones:
#   1. Copia este archivo: cp .env.example .env.local
#   2. Rellena cada variable con tus credenciales reales
#   3. NUNCA subas .env.local a Git (ya está en .gitignore)
# ============================================

# ---- Supabase (OBLIGATORIO) ----
# Obtén estas llaves en: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key-here

# ---- Web Push Notifications (opcional) ----
# Genera tus llaves VAPID en: https://vapidkeys.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# ---- Arduino / Serial (opcional - solo para producción física) ----
# Baud rate para comunicación con Arduino UNO
NEXT_PUBLIC_SERIAL_BAUD_RATE=9600
